{
  "name": "equipment-monitoring",
  "version": "1.0.0",
  "description": "Real-Time Equipment Monitoring & Alerting System (SAP CAP + Event Mesh + Fiori)",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cap-js/hana": "^1",
    "@sap/cds": "^8.6.0",
    "@sap/xssec": "^4",
    "express": "^4",
    "mqtt": "^5.15.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^8",
    "axios": "^1.18.1",
    "chai": "^5",
    "chai-as-promised": "^8",
    "chai-subset": "^1",
    "jest": "^29"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "cds build --production",
    "deploy": "mbt build -t ./ --mtar mta.tar && cf deploy mta.tar",
    "seed:events": "node scripts/simulate-publisher.js",
    "test": "jest"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sql"
      },
      "auth": {
        "[development]": {
          "kind": "mocked-auth"
        },
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "messaging": {
        "[development]": {
          "kind": "file-based-messaging"
        },
        "[test]": {
          "kind": "local-messaging"
        },
        "[production]": {
          "kind": "local-messaging"
        }
      },
      "ExternalMaintenanceAPI": {
        "kind": "odata-v4",
        "model": "srv/external/maintenance-api",
        "[development]": {
          "credentials": {
            "url": "http://localhost:4005/odata/v4/maintenance"
          }
        },
        "[production]": {
          "credentials": {
            "destination": "MaintenanceBackend",
            "path": "/odata/v4/maintenance"
          }
        }
      }
    }
  }
}
