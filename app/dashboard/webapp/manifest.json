{
  "_version": "1.60.0",
  "sap.app": {
    "id": "sce.monitoring.dashboard",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "monitoring": {
        "uri": "/monitoring/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      },
      "alerting": {
        "uri": "/alerting/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "sce.monitoring.dashboard.view.Dashboard",
      "type": "XML",
      "id": "dashboard",
      "async": true
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.f": {},
        "sap.suite.ui.microchart": {},
        "sap.ui.table": {}
      }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "sce.monitoring.dashboard.i18n.i18n" }
      },
      "": {
        "dataSource": "monitoring",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "alerting": {
        "dataSource": "alerting",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      }
    },
    "resources": {
      "css": [{ "uri": "css/style.css" }]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "sce.monitoring.dashboard.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        { "name": "dashboard", "pattern": "", "target": "dashboard" }
      ],
      "targets": {
        "dashboard": { "viewId": "dashboard", "viewName": "Dashboard" }
      }
    }
  }
}
