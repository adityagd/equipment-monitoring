# Solace PubSub+ connection for the local dev bridge (srv/server.js).
# Copy to `.env` and fill in from the Solace Cloud "Connect" tab (MQTT section).
# Leave unset to run purely on internal messaging (no broker).

# Secured MQTT endpoint, e.g. mqtts://mr-abc123.messaging.solace.cloud:8883
SOLACE_MQTT_URL=
SOLACE_MQTT_USERNAME=
SOLACE_MQTT_PASSWORD=
